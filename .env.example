# AI Mesh — Environment Variables
# Most values have sensible defaults. Only set what you need.

# ─── Required for Production ───
# SESSION_SECRET: Auto-generated if not set (tokens expire on restart).
# Set this for persistent tokens across restarts.
# Generate: openssl rand -hex 32
# SESSION_SECRET=***

# UI_URL: Auto-detected on Railway, Render, Vercel, Fly.io.
# Only set manually if deploying elsewhere.
# UI_URL=https://your-domain.com

# ─── GitHub OAuth (Optional) ───
# Without these, users register with username/password.
# With these, users can also login via GitHub.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://your-domain.com/auth/github/callback

# ─── NATS Relay ───
# Auto-started locally if not set. For external NATS:
# NATS_URL=nats://user:pass@your-nats:4222

# ─── Optional ───
# PORT=3737
# HOST=0.0.0.0
# NODE_ENV=production
# DB_PATH=./data/ai-mesh.db
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# MESSAGE_MAX_BYTES=16384
# MESSAGE_HOLD_MS=604800000
