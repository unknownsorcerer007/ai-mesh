# Server
PORT=3737
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3737

# NATS Relay
NATS_URL=nats://localhost:4222

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3737/auth/github/callback

# Session (REQUIRED in production — generate with: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-random-string

# Database
DB_PATH=./data/ai-mesh.db

# Message hold time (ms) — offline messages kept for this long
MESSAGE_HOLD_MS=604800000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Message size limit (bytes) — default 16KB
MESSAGE_MAX_BYTES=16384
